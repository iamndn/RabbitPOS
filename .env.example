# ==============================================================================
# RabbitPOS (ThoPOS) - Unified Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development or production deployment.
# Environment variables set here are consumed by Docker Compose, Go Backend, and Next.js.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global & Application Environment
# ------------------------------------------------------------------------------
# Environment mode: 'development' or 'production'
APP_ENV=development

# ------------------------------------------------------------------------------
# 2. PostgreSQL Container & Database Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rabbitpos
POSTGRES_PORT=5432

# Backend Database Connection (GORM DSN)
# Use 'postgres' inside Docker network, or 'localhost' when running Go locally
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rabbitpos

# ------------------------------------------------------------------------------
# 3. Go Backend API Configuration
# ------------------------------------------------------------------------------
# Backend HTTP listener port
PORT=8080
BACKEND_PORT=8080

# Allowed CORS Origins (comma-separated origins or '*')
# Dev example : http://localhost:3000,http://10.0.0.10:3000
# Prod example: https://thopos.ndnworks.com,https://rabbitpos.ndnworks.com
CORS_ORIGIN=http://localhost:3000,http://10.0.0.10:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.0.10:3000

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens (Change to a strong 256-bit random key in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# ------------------------------------------------------------------------------
# 5. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
# Frontend HTTP listener port
FRONTEND_PORT=3000

# Public API URL used by Next.js client-side fetchers
# Dev example : http://localhost:8080/api/v1 or http://10.0.0.10:8080/api/v1
# Prod example: https://api.thopos.ndnworks.com/api/v1 or https://api.rabbitpos.ndnworks.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
