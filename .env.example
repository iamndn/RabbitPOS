# ==============================================================================
# RabbitPOS - Unified Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
#   - Development: Copy this file to '.env' (root) or rely on docker-compose.yml defaults.
#   - Production : Set these variables in '.env' on the target server or inject them via
#                  CI/CD pipeline / Proxmox deployment script.
#                  DO NOT commit real credentials or .env.production to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global & Application Environment
# ------------------------------------------------------------------------------
# Mode: 'development' (default) or 'production'
# In production, Go backend sets Gin to ReleaseMode and enforces strict security.
APP_ENV=development

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Container & DB credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=rabbitpos
POSTGRES_PORT=5432

# Backend database connection variables (for local non-docker Go execution)
# When running inside Docker Compose, DB_HOST is automatically routed to 'postgres'
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here
DB_NAME=rabbitpos

# ------------------------------------------------------------------------------
# 3. Go Backend API Configuration
# ------------------------------------------------------------------------------
# HTTP listener port for Go backend
PORT=8080
BACKEND_PORT=8080

# [REQUIRED IN PRODUCTION] Allowed CORS Origins (comma-separated domains)
# Dev : http://localhost:3000,http://10.0.0.10:3000
# Prod: https://rabbitpos.ndnworks.com,https://rabbitpos.ndnworks.com
CORS_ORIGIN=http://localhost:3000,http://10.0.0.10:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.0.10:3000

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] JWT Signing Secret (Minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# ------------------------------------------------------------------------------
# 5. Database Seeding & Initial Credentials
# ------------------------------------------------------------------------------
# Seeding mode:
#   true  - Inserts demo categories, sample beverages, variants, and test staff account.
#   false - Skips demo catalog data; only creates essential funds, system settings, and admin.
# (Production compose strictly sets this to false)
ENABLE_SEEDING=true

# [REQUIRED IN PRODUCTION] Initial Admin Account (created on first DB initialization)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=your_strong_admin_password_here

# Initial Staff Account (only seeded when ENABLE_SEEDING=true in development)
INITIAL_STAFF_USERNAME=staff
INITIAL_STAFF_PASSWORD=your_strong_staff_password_here

# ------------------------------------------------------------------------------
# 6. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
# HTTP listener port for Next.js
FRONTEND_PORT=3000

# [REQUIRED IN PRODUCTION] Public API URL baked into Next.js bundles during build
# Dev : http://localhost:8080/api/v1  or  http://10.0.0.10:8080/api/v1
# Prod: https://api.rabbitpos.ndnworks.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
