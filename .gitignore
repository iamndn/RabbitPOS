# ==============================================================================
# RabbitPOS - Root .gitignore
# ==============================================================================

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/
.turbo/
*.tsbuildinfo
frontend/*.tsbuildinfo
.gemini/

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.production
*.env.development
*.env.local
backend/.env*
!backend/.env.example
frontend/.env*
!frontend/.env.example

# Compiled Binaries & Executables
*.exe
.xlsx
*.exe~
*.dll
*.so
*.dylib
*.bin
main
main.exe
backend/main
backend/main.exe
gen-lang-client.json

# Go Module Cache & Dependencies
.gomodcache/
backend/.gomodcache/
vendor/
backend/vendor/

# Uploaded Media & Files
uploads/
backend/uploads/

# Database Backups & Dumps
backups/
*.sql
*.sql.gz
*.dump
*.tar
*.bak

# Nginx Proxy Manager & SSL Certificates
npm_data/
npm_letsencrypt/
*.pem
*.crt
*.key
*.csr

# Logs & Debugging
*.log
logs/

# OS & Editor Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~