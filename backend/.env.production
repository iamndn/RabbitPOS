# ==============================================================================
# RabbitPOS Backend - Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: This file is a TEMPLATE. Fill in all values marked with <CHANGE_ME>
# before deploying. Never commit real credentials to version control.
# On the production server, inject these values via Docker environment or
# a secrets manager — do NOT rely on this file being present on disk.
# ==============================================================================

APP_ENV=production
PORT=8080

# PostgreSQL connection (use 'postgres' as DB_HOST when running inside Docker Compose)
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=SGsurv9wi7uQRXXniYj0kg1V8TunrUnR
DB_NAME=rabbitpos

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGIN=https://rabbitpos.ndnworks.com,https://rabbitpos.ndnworks.com
CORS_ALLOWED_ORIGINS=https://rabbitpos.ndnworks.com,https://rabbitpos.ndnworks.com

# JWT Secret: MUST be a strong random key (min 32 chars). Generate with:
#   openssl rand -hex 32
JWT_SECRET=c9aa711cad6eb5a75bdb85269ad068b78081c98d8bab9c75a3668ea55d8730a3
JWT_EXPIRY_HOURS=24

# Seeding: NEVER enable in production — prevents demo data pollution
ENABLE_SEEDING=false

# Initial admin account: created on first startup if no users exist in the database.
# Leave blank to skip admin creation (manual setup required).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=1oUkhUsL7ZZAppV51TYgXw
