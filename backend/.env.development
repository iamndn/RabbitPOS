# ==============================================================================
# RabbitPOS Backend - Development Environment Configuration
# ==============================================================================
APP_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rabbitpos
CORS_ORIGIN=http://localhost:3000,http://10.0.0.10:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.0.10:3000
JWT_SECRET=rabbitpos-dev-jwt-secret-key-2026-not-for-production
JWT_EXPIRY_HOURS=24

# Seeding: enable demo catalog, sample products, and default staff account in development
ENABLE_SEEDING=true

# Initial admin account credentials (created on first run if no users exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# Initial staff account (only created when ENABLE_SEEDING=true)
INITIAL_STAFF_USERNAME=staff
INITIAL_STAFF_PASSWORD=staff123
